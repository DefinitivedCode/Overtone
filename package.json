{
  "name": "overtone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first lyrics learner for Korean, Japanese, Mandarin and Cantonese.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "comlink": "4.4.2",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lindera-wasm-web-ipadic": "2.0.0",
